# Private credentials and local configuration; never force-add these.
/signing/
**/keystore-password.txt
*.jks
*.keystore
*.p12
*.pfx
.env
.env.*
!.env.example
!.env.sample
local.properties
*Private-Source*.zip
LightForge-diagnostics-*.txt

# Installed tools, dependencies, IDE state and reproducible build outputs.
/build/
/dist/
/output/
**/toolchain/
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.gradle/
.idea/
*.iml
.DS_Store
*.apk
*.ap_
*.dex
*.class

# Reproduce these graphs from the pinned converters/manifests.
# Canonical retained models, WASM, geometry and notices remain tracked.
web/analysis/models/game/*.onnx
web/analysis/models/deux/*.onnx

# Downloaded/generated test data. Existing committed evidence stays historical.
qa/hardware-1.2.0/fixtures/
qa/release-*/fixtures/
qa/release-*/native-*-fixtures/
qa/release-*/native-classes/
qa/release-*/*.f32
qa/release-*/browser-export.fseq
qa/**/*activations*.json

# Retired transfer copies are not build inputs; use Releases or Git history.
/migration/
/releases/*/parts/
